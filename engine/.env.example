# Copy to engine/.env for custom settings. The key is easiest to set with “Connect Claude”
# in the app, which checks it and writes it here. Real environment variables win.
ANTHROPIC_API_KEY=
RETICULATE_MODEL=claude-opus-5-5
RETICULATE_EFFORT=high            # low | medium | high | xhigh | max
RETICULATE_CONCURRENCY=6          # parallel model calls during a run
