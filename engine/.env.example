# Copy to engine/.env for custom settings. The key is easiest to set with “Connect Claude”
# in the app, which checks it and writes it here. Real environment variables win.
ANTHROPIC_API_KEY=
RETICULATE_MODEL=claude-opus-5-5
RETICULATE_EFFORT=high            # the panel and tipping points: low | medium | high | xhigh | max
RETICULATE_DIALOGUE_EFFORT=medium # each question of the dialogue (lower is faster)
RETICULATE_CONCURRENCY=6          # parallel model calls during a panel
# RETICULATE_DATA_DIR=            # where decisions, avatars and runs are saved (default: data/)
